<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase 1 Layer 3 — :app/AndroidManifest.xml.

  Permissions trimmed to the bare minimum for the route-war machinery
  per doc/BUILD_ORDER.md §Layer 3 lines 157–168. Later layers add their
  own permissions alongside the consumer feature (Layer 4 adds
  FOREGROUND_SERVICE_MEDIA_PROJECTION + RECORD_AUDIO, Layer 6+ adds
  INTERNET + ACCESS_NETWORK_STATE, etc.).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Foreground service: required to run a persistent service on A12+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- A14: must declare the service-type subpermission matching
         PersistentAudioService's foregroundServiceType in the manifest. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Layer 4 — capture pipeline.
         FOREGROUND_SERVICE_MEDIA_PROJECTION lets us combine the
         mediaProjection type onto PersistentAudioService when a capture
         session is active. RECORD_AUDIO is required to instantiate
         AudioRecord against an AudioPlaybackCaptureConfiguration. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- AudioManager.mode + setSpeakerphoneOn require MODIFY_AUDIO_SETTINGS. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- BootReceiver requires this permission to receive the broadcast. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- A13+ runtime permission for posting the foreground notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- PARTIAL_WAKE_LOCK keeps the CPU awake while the SpeakerForceEngine
         tick loop is engaged. Without it the 500ms cadence drifts past 1s on
         AGGRESSIVE-restriction OEMs like Nokia (Evenwell). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Lets BootstrapActivity launch the system "Battery optimisation" prompt
         so the user can whitelist Vyzorix in one tap. Without the whitelist
         Nokia kills the daemon within ~6 hours of standby. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".VyzorixApplication"
        android:label="VyzorixAudioRouter"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:fullBackupContent="false"
        tools:targetApi="33">

        <!--
          BootstrapActivity — the single launcher entrypoint. Once
          accessibility is enabled, LauncherIconHider disables this
          activity via PackageManager.setComponentEnabledSetting(...).
        -->
        <activity
            android:name=".BootstrapActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Vyzorix.Bootstrap">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          We intentionally re-declare PersistentAudioService here (alongside
          the merged library-side declaration in :core:services) with the
          fully-qualified name. AGP de-duplicates identical service entries;
          this stays as documentation for code reviewers.
        -->

        <!--
          Layer 4 — ProjectionPermissionActivity. Translucent one-shot
          trampoline that requests a MediaProjection token. Not exported
          (only the daemon launches it) and themed translucent so the
          user never sees a visible window.
        -->
        <activity
            android:name=".ProjectionPermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.Vyzorix.Trampoline" />

    </application>

</manifest>
