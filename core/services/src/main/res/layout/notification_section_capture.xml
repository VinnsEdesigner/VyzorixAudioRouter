<?xml version="1.0" encoding="utf-8"?>
<!-- Tier 2: capture engine status. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/notification_section_capture_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
        android:text="Capture" />

    <TextView
        android:id="@+id/notification_section_capture_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@android:style/TextAppearance.Material.Notification"
        android:text="IDLE" />

    <TextView
        android:id="@+id/notification_section_capture_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Info"
        android:text="projection token: —" />

</LinearLayout>
