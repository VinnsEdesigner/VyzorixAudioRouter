<?xml version="1.0" encoding="utf-8"?>
<!--
  Collapsed (Tier 1) RemoteViews surface for the daemon notification.
  Rendered by the system UI; only the resource types whitelisted in
  https://developer.android.com/reference/android/widget/RemoteViews
  may appear here.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/notification_dashboard_collapsed_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@android:drawable/stat_notify_voicemail"
        android:contentDescription="@string/daemon_notification_title" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="0dp">

        <TextView
            android:id="@+id/notification_dashboard_collapsed_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:text="@string/daemon_notification_title" />

        <TextView
            android:id="@+id/notification_dashboard_collapsed_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textAppearance="@android:style/TextAppearance.Material.Notification"
            android:text="@string/daemon_notification_text_starting" />

    </LinearLayout>

    <TextView
        android:id="@+id/notification_dashboard_collapsed_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Info"
        android:singleLine="true"
        android:textStyle="bold"
        android:text="—" />

</LinearLayout>
